{
  "name": "cypress-e2e-automation",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "cypress": "^15.18.1",
    "cypress-mochawesome-reporter": "^5.0.0",
    "typescript": "^6.0.0"
  },
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:authentication": "cypress run --spec \"cypress/e2e/authentication/**/*\"",
    "test:cart": "cypress run --spec \"cypress/e2e/cart/**/*\"",
    "test:checkout": "cypress run --spec \"cypress/e2e/checkout/**/*\"",
    "test:product-comments": "cypress run --spec \"cypress/e2e/productComments/**/*\""
  },
  "type": "module"
}
