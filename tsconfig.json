{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "skipLibCheck": true,

    "types": ["cypress"],

    "noEmit": true
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts", "cypress/**/*.d.ts"]
}
